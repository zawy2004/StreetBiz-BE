# Copy to /opt/streetbiz/api.env on the VPS and fill in. Passed to the API container only.
# Names use __ for ':' (Jwt__SigningKey = Jwt:SigningKey). Never commit the real file.
# Generate each key on the server with:  openssl rand -base64 48
# (never reuse a dev-... key from git history or from your own machine)

# --- Required: the API refuses to start without these ---
Jwt__SigningKey=
Permit__SigningKey=
OrderPickup__SigningKey=
Otp__HashKey=

# --- Required for the product to work ---
# The Vercel site, no trailing slash. Add __1, __2 for a custom domain or preview URLs.
Cors__AllowedOrigins__0=https://streetbiz.vercel.app
# Printed price-board QR codes link to {PublicScanBaseUrl}/q/{token}: the Vercel site.
Permit__PublicScanBaseUrl=https://streetbiz.vercel.app
# SMS for OTP (sign-up, password reset, OTP sign-in). Without it OTP requests fail; password login still works.
# eSMS.vn: ApiKey + SecretKey from "Quan ly API eSMS". SmsType 8 = fixed number, no brandname needed.
# Sandbox=true only validates the request (nothing is sent or charged); keep false in production.
Sms__Provider=Esms
Sms__ApiKey=
Sms__SecretKey=
Sms__SmsType=8
Sms__Sandbox=false
# Any other gateway: Sms__Provider=Http plus Sms__Endpoint and Sms__Sender (docs/deploy-vps.md).

# --- payOS (bank transfer by VietQR straight to each household / ward, docs/payos-payments.md) ---
# Encrypts the payOS keys each payee connects. Base64 of exactly 32 bytes: openssl rand -base64 32
# Without it payOS stays off in Production. Changing it later makes connected channels unreadable.
Payments__PayOs__CredentialKey=
# The API's public https origin (no /api): payOS posts its webhook to {this}/api/payments/payos/callback/...
Payments__PayOs__PublicWebhookBaseUrl=https://api.example.com
# Where payOS sends the payer back: the Vercel site.
Payments__PayOs__FrontendBaseUrl=https://streetbiz.vercel.app
# Keep sandbox (fake) payments off in production.
Payments__SandboxEnabled=false

# --- Optional ---
# Log timestamps in Vietnam time. The app itself works in UTC, so only the log output changes.
TZ=Asia/Ho_Chi_Minh
# Payment problems posted to a Discord channel
# Alerts__DiscordWebhookUrl=
# AI: eKYC (FPT.AI), document checks and the chatbot (Gemini, Groq). A model name is needed with each key.
# AiCompliance__FptAi__ApiKey=
# AiCompliance__FptAi__ApiUrl=https://api.fpt.ai/vision/idr/vnm
# AiCompliance__Gemini__ApiKeys__0=
# AiCompliance__Gemini__Model=gemini-3.8-flash
# AiCompliance__Groq__ApiKeys__0=
# AiCompliance__Groq__Model=openai/gpt-oss-120b
# Verified ward boundaries for the location check (docs/ward-slot-workflows.md); without them it answers 503
# Geolocation__Boundaries__0__...   (one entry per ward; fields in docs/ward-slot-workflows.md)
# Nominatim asks for a contact in the User-Agent
# Nominatim__UserAgent=StreetBiz/1.0 (contact@example.com)
# Push notifications to the mobile app go through Expo (no key needed). Off switch, and the token
# needed only if "enhanced push security" is turned on for the Expo project:
# Push__Enabled=false
# Push__ExpoAccessToken=
# Deletes dish/store photos and avatars nothing references after GraceHours (default on, every 360 minutes)
# OrphanImageCleanup__Enabled=false
# OrphanImageCleanup__GraceHours=24
