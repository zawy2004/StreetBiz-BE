# Copy to /opt/streetbiz/api.env on the VPS and fill in. Passed to the API container only.
# Names use __ for ':' (Jwt__SigningKey = Jwt:SigningKey). Never commit the real file.
# Generate each key with: openssl rand -base64 48   (never reuse a dev-... key from git history)

# --- Required: the API refuses to start without these ---
Jwt__SigningKey=
Permit__SigningKey=
OrderPickup__SigningKey=
Otp__HashKey=

# --- Required for the product to work ---
# The Vercel site, no trailing slash. Add __1, __2 for a custom domain or preview URLs.
Cors__AllowedOrigins__0=https://streetbiz.vercel.app
# Printed price-board QR codes link to {PublicScanBaseUrl}/q/{token}: the Vercel site.
Permit__PublicScanBaseUrl=https://streetbiz.vercel.app
# SMS for OTP (sign-up, password reset). Without it OTP requests fail.
Sms__Provider=Http
Sms__Endpoint=
Sms__ApiKey=

# --- Optional ---
# payOS / MoMo (see docs/payos-payments.md). Keep sandbox payments off in production.
Payments__SandboxEnabled=false
# Payments__Momo__PartnerCode=
# Payments__Momo__AccessKey=
# Payments__Momo__SecretKey=
# Payments__Momo__ReturnUrl=https://streetbiz.vercel.app/...
# Payments__Momo__NotifyUrl=https://api.example.com/api/payments/momo/callback
# AI (eKYC, document checks, chatbot)
# AiCompliance__FptAi__ApiKey=
# AiCompliance__Gemini__ApiKeys__0=
# AiCompliance__Groq__ApiKeys__0=
# Nominatim asks for a contact in the User-Agent
# Nominatim__UserAgent=StreetBiz/1.0 (contact@example.com)
# Serverless-style databases only: lengthen the fee sweep so the DB can idle (not needed on a VPS)
# FeeReminders__SweepIntervalMinutes=60
# Error monitoring through Application Insights (works from any host), off when unset
# APPLICATIONINSIGHTS_CONNECTION_STRING=
