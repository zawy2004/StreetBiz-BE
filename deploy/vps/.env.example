# Copy to /opt/streetbiz/.env on the VPS and fill in. Read by docker compose only (never by the
# API container). Never commit the real file.

# Public name of the API; its DNS A record must point at the VPS. Caddy gets the certificate.
API_DOMAIN=api.example.com
# Image to run. The deploy workflow sets IMAGE_TAG to the commit SHA on every deploy.
API_IMAGE=ghcr.io/zawy2004/streetbiz-api
IMAGE_TAG=latest

# SQL Server. sa is used only by init-db.sh and backup.sh; the API uses DB_APP_USER.
# Passwords: 8+ characters from 3 of upper, lower, digit, symbol (SQL Server policy), e.g.
#   echo "Sb-$(openssl rand -hex 12)"   Never use $ ; ' or " (they break compose or the connection string).
SQLSERVER_SA_PASSWORD=
DB_APP_USER=streetbiz_app
DB_APP_PASSWORD=
MSSQL_PID=Express
# SQL Server refuses to start below 2 GB. On a 4 GB VPS also add swap (docs/deploy-vps.md).
MSSQL_MEMORY_LIMIT_MB=2048

# Days of backups kept in ./backups by backup.sh.
BACKUP_KEEP_DAYS=14
