{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "StreetBiz.API"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StreetBiz",
    "Audience": "StreetBiz",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Permit": {
    "SigningKey": ""
  },
  "Storage": {
    "_comment": "Provider is Local (disk) or AzureBlob. Put AzureBlob:ConnectionString (or AccountUrl for managed identity) in user-secrets / env var Storage__AzureBlob__ConnectionString, never here.",
    "Provider": "Local",
    "RootPath": "App_Data/uploads",
    "AzureBlob": {
      "ContainerName": "streetbiz-uploads"
    }
  },
  "OrderPickup": {
    "SigningKey": ""
  },
  "PickupRange": {
    "_comment": "ORD-01: pickup-only orders may only be placed within RadiusMeters of the stall (see docs/order-tracking-pickup-range.md).",
    "Enforced": true,
    "RadiusMeters": 2000,
    "AccuracyAllowanceMeters": 150,
    "MaxAccuracyMeters": 1000
  },
  "Payments": {
    "SandboxEnabled": false,
    "Momo": {
      "CheckoutUrlTemplate": "",
      "CallbackSecret": "",
      "_comment": "MoMo v2 keys go in appsettings.Development.json or user-secrets, never here.",
      "ApiBaseUrl": "",
      "PartnerCode": "",
      "AccessKey": "",
      "SecretKey": "",
      "ReturnUrl": "",
      "FeeReturnUrl": "",
      "PenaltyReturnUrl": "",
      "NotifyUrl": "",
      "RequestType": "captureWallet"
    },
    "ZaloPay": {
      "CheckoutUrlTemplate": "",
      "CallbackSecret": ""
    },
    "SePay": {
      "_comment": "Bank transfer by VietQR (docs/sepay-payments.md). WebhookSecret, WebhookApiKey and ApiToken go in user-secrets, never here.",
      "BankName": "",
      "AccountNumber": "",
      "AccountName": "",
      "PaymentCodePrefix": "SBP",
      "TransferContentTemplate": "{code}",
      "WebhookSecret": "",
      "WebhookApiKey": "",
      "ApiToken": "",
      "ApiBaseUrl": "https://my.sepay.vn/userapi",
      "QrImageBaseUrl": "https://qr.sepay.vn/img"
    }
  },
  "Alerts": {
    "_comment": "Payment alerts to a Discord channel (docs/sepay-payments.md). The webhook URL goes in user-secrets.",
    "DiscordWebhookUrl": "",
    "DiscordMention": ""
  },
  "FeeReminders": {
    "SweepIntervalMinutes": 60
  }
}
