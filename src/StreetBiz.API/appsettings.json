{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "StreetBiz.API"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StreetBiz",
    "Audience": "StreetBiz",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Permit": {
    "SigningKey": ""
  },
  "Storage": {
    "_comment": "Provider is Local (disk) or AzureBlob. Put AzureBlob:ConnectionString (or AccountUrl for managed identity) in user-secrets / env var Storage__AzureBlob__ConnectionString, never here.",
    "Provider": "Local",
    "RootPath": "App_Data/uploads",
    "AzureBlob": {
      "ContainerName": "streetbiz-uploads"
    }
  },
  "OrderPickup": {
    "SigningKey": ""
  },
  "PickupRange": {
    "_comment": "ORD-01: pickup-only orders may only be placed within RadiusMeters of the stall (see docs/order-tracking-pickup-range.md).",
    "Enforced": true,
    "RadiusMeters": 2000,
    "AccuracyAllowanceMeters": 150,
    "MaxAccuracyMeters": 1000
  },
  "Payments": {
    "SandboxEnabled": false,
    "Momo": {
      "CheckoutUrlTemplate": "",
      "CallbackSecret": "",
      "_comment": "MoMo v2 keys go in appsettings.Development.json or user-secrets, never here.",
      "ApiBaseUrl": "",
      "PartnerCode": "",
      "AccessKey": "",
      "SecretKey": "",
      "ReturnUrl": "",
      "FeeReturnUrl": "",
      "PenaltyReturnUrl": "",
      "NotifyUrl": "",
      "RequestType": "captureWallet"
    },
    "ZaloPay": {
      "CheckoutUrlTemplate": "",
      "CallbackSecret": "",
      "_comment": "ZaloPay Gateway v2 is OFF until Enabled is true and every key below is set (user-secrets / environment, never here). Not yet tested against ZaloPay's real sandbox.",
      "Enabled": false,
      "ApiBaseUrl": "",
      "AppId": "",
      "Key1": "",
      "Key2": "",
      "ReturnUrl": "",
      "FeeReturnUrl": "",
      "PenaltyReturnUrl": "",
      "CallbackUrl": ""
    }
  },
  "FeeReminders": {
    "SweepIntervalMinutes": 60
  },
  "BusinessCalendar": {
    "ExtraHolidays": [],
    "ExtraWorkingDays": []
  }
}
